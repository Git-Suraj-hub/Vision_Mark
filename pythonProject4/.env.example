# ==============================================================================
# VISION MARK — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to public version control!
# ==============================================================================

# Database Configuration (MySQL / TiDB Cloud Serverless)
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username_here
DB_PASSWORD=your_tidb_strong_password_here
DB_NAME=face_detection
DB_SSL_DISABLED=False

# Session Security & Application Secrets
SECRET_KEY=generate_a_secure_random_hex_string_32_bytes
SESSION_EXPIRE_SECONDS=21600

# Server Binding
HOST=127.0.0.1
PORT=8000

# Default Camera Configuration (0 for internal webcam, or RTSP/HTTP URL)
DEFAULT_CAMERA_SOURCE=0
